# Elixir buildpack configuration for Gigalixir
# https://gigalixir.readthedocs.io/en/latest/config.html

# Elixir version (must match your local version)
elixir_version=1.14.3

# Erlang version (compatible with Elixir 1.14.x)
erlang_version=25.3

# Always rebuild from scratch (cleaner builds)
always_rebuild=false
