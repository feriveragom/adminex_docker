<div class="space-y-6">
  <%!-- Header con filtros --%>
  <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4 md:p-6">
    <div class="flex flex-col gap-4">
      <%!-- Título y navegación --%>
      <div class="flex items-center gap-4">
        <.link navigate={~p"/admin"} class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </.link>
        <div>
          <h1 class="text-xl md:text-2xl font-bold text-primary-900 dark:text-primary-100">Auditoría</h1>
          <p class="text-sm text-primary-500 dark:text-primary-400"><%= length(@logs) %> registros encontrados</p>
        </div>
      </div>
      
      <%!-- Filtros --%>
      <form phx-change="filter" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <%!-- Usuario --%>
        <div>
          <label class="block text-xs font-medium text-primary-600 dark:text-primary-400 mb-1">Usuario</label>
          <select
            name="user_id"
            class="w-full px-3 py-2 rounded-xl border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 text-sm focus:ring-2 focus:ring-accent focus:border-transparent"
          >
            <option value="">Todos los usuarios</option>
            <%= for user <- @users do %>
              <option value={user.id} selected={@user_filter == user.id}><%= user.email %></option>
            <% end %>
          </select>
        </div>
        
        <%!-- Fecha desde --%>
        <div>
          <label class="block text-xs font-medium text-primary-600 dark:text-primary-400 mb-1">Desde</label>
          <input
            type="date"
            name="date_from"
            value={@date_from}
            class="w-full px-3 py-2 rounded-xl border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 text-sm focus:ring-2 focus:ring-accent focus:border-transparent"
          />
        </div>
        
        <%!-- Fecha hasta --%>
        <div>
          <label class="block text-xs font-medium text-primary-600 dark:text-primary-400 mb-1">Hasta</label>
          <input
            type="date"
            name="date_to"
            value={@date_to}
            class="w-full px-3 py-2 rounded-xl border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 text-sm focus:ring-2 focus:ring-accent focus:border-transparent"
          />
        </div>
        
        <%!-- Limpiar filtros --%>
        <div class="flex items-end">
          <button
            type="button"
            phx-click="clear_filters"
            class="w-full px-3 py-2 rounded-xl border border-primary-200 dark:border-primary-700 text-primary-600 dark:text-primary-400 hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors text-sm flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Hoy
          </button>
        </div>
      </form>
    </div>
  </div>

  <%!-- Loading state --%>
  <%= if @loading do %>
    <div class="flex items-center justify-center py-12">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent"></div>
    </div>
  <% else %>
    <%!-- Mobile: Cards --%>
    <div class="md:hidden space-y-3">
      <%= if Enum.empty?(@logs) do %>
        <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-8 text-center">
          <svg class="w-12 h-12 mx-auto text-primary-300 dark:text-primary-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-primary-500 dark:text-primary-400">No hay registros para los filtros seleccionados</p>
        </div>
      <% else %>
        <%= for log <- @logs do %>
          <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1">
                <span class={"px-2 py-0.5 rounded-full text-xs font-medium " <> action_color(log.action)}>
                  <%= log.action %>
                </span>
                <p class="text-sm text-primary-600 dark:text-primary-400 mt-2">
                  <%= if log.actor do %>
                    <span class="font-medium"><%= log.actor.email %></span>
                  <% else %>
                    <span class="italic">Sistema</span>
                  <% end %>
                </p>
                <%= if log.resource_type do %>
                  <p class="text-xs text-primary-500 mt-1">
                    <%= log.resource_type %><%= if log.resource_id, do: " ##{String.slice(log.resource_id, 0..7)}..." %>
                  </p>
                <% end %>
              </div>
              <div class="text-right">
                <p class="text-xs text-primary-500 dark:text-primary-400">
                  <%= Calendar.strftime(log.inserted_at, "%d/%m/%Y") %>
                </p>
                <p class="text-xs text-primary-400">
                  <%= Calendar.strftime(log.inserted_at, "%H:%M:%S") %>
                </p>
              </div>
            </div>
            
            <%= if log.ip_address do %>
              <div class="mt-2 pt-2 border-t border-primary-100 dark:border-primary-800">
                <p class="text-xs text-primary-400">
                  IP: <%= log.ip_address %>
                </p>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%!-- Desktop: Table --%>
    <div class="hidden md:block bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir overflow-hidden">
      <%= if Enum.empty?(@logs) do %>
        <div class="p-12 text-center">
          <svg class="w-16 h-16 mx-auto text-primary-300 dark:text-primary-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-lg text-primary-500 dark:text-primary-400">No hay registros de auditoría</p>
          <p class="text-sm text-primary-400 mt-1">Prueba cambiando los filtros</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-primary-50 dark:bg-primary-800/50">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Fecha/Hora</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Acción</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Usuario</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Recurso</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">IP</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary-100 dark:divide-primary-800">
              <%= for log <- @logs do %>
                <tr class="hover:bg-primary-50 dark:hover:bg-primary-800/30 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <p class="text-sm font-medium text-primary-900 dark:text-primary-100">
                      <%= Calendar.strftime(log.inserted_at, "%d/%m/%Y") %>
                    </p>
                    <p class="text-xs text-primary-500">
                      <%= Calendar.strftime(log.inserted_at, "%H:%M:%S") %>
                    </p>
                  </td>
                  <td class="px-6 py-4">
                    <span class={"px-3 py-1 rounded-full text-xs font-medium " <> action_color(log.action)}>
                      <%= log.action %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <%= if log.actor do %>
                      <div class="flex items-center gap-2">
                        <%= if log.actor.picture do %>
                          <img src={log.actor.picture} class="w-6 h-6 rounded-full" alt="" />
                        <% else %>
                          <div class="w-6 h-6 rounded-full bg-gradient-elixir flex items-center justify-center text-white text-xs font-bold">
                            <%= String.first(log.actor.email) |> String.upcase() %>
                          </div>
                        <% end %>
                        <span class="text-sm text-primary-900 dark:text-primary-100"><%= log.actor.email %></span>
                      </div>
                    <% else %>
                      <span class="text-sm text-primary-400 italic">Sistema</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4">
                    <%= if log.resource_type do %>
                      <div>
                        <span class="text-sm text-primary-700 dark:text-primary-300"><%= log.resource_type %></span>
                        <%= if log.resource_id do %>
                          <p class="text-xs text-primary-400 font-mono"><%= String.slice(log.resource_id, 0..11) %>...</p>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-primary-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4">
                    <%= if log.ip_address do %>
                      <span class="text-sm text-primary-500 font-mono"><%= log.ip_address %></span>
                    <% else %>
                      <span class="text-primary-400">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
