<div class="space-y-6">
  <%!-- Header con búsqueda y botón nuevo --%>
  <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4 md:p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-4">
        <.link navigate={~p"/admin"} class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </.link>
        <div>
          <h1 class="text-xl md:text-2xl font-bold text-primary-900 dark:text-primary-100">Roles</h1>
          <p class="text-sm text-primary-500 dark:text-primary-400"><%= length(@roles) %> roles configurados</p>
        </div>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-3">
        <%!-- Búsqueda --%>
        <form phx-change="search" phx-submit="search" class="flex-1">
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              name="search"
              value={@search}
              placeholder="Buscar rol..."
              class="w-full pl-10 pr-4 py-2 rounded-xl border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
              phx-debounce="300"
            />
          </div>
        </form>
        
        <%!-- Botón nuevo --%>
        <button
          phx-click="new"
          class="px-4 py-2 rounded-xl bg-gradient-elixir text-white font-medium hover:opacity-90 transition-opacity flex items-center gap-2 justify-center"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Nuevo Rol</span>
        </button>
      </div>
    </div>
  </div>

  <%!-- Mobile: Cards --%>
  <div class="md:hidden space-y-4">
    <%= for role <- @roles do %>
      <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-semibold text-primary-900 dark:text-primary-100"><%= role.name %></h3>
            <p class="text-sm text-primary-500 dark:text-primary-400 mt-1"><%= role.description || "Sin descripción" %></p>
          </div>
          
          <div class="flex items-center gap-2">
            <button
              phx-click="edit"
              phx-value-id={role.id}
              class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
              title="Editar"
            >
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </button>
            <button
              type="button"
              phx-click="confirm_delete"
              phx-value-id={role.id}
              class="p-2 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
              title="Eliminar"
            >
              <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>
        
        <%!-- Permisos como badges --%>
        <div class="mt-3 flex flex-wrap gap-1">
          <%= for permission <- role.permissions do %>
            <span class="px-2 py-0.5 rounded-full text-xs bg-accent/20 text-accent-dark dark:text-accent">
              <%= permission.code %>
            </span>
          <% end %>
          <%= if Enum.empty?(role.permissions) do %>
            <span class="text-xs text-primary-400 italic">Sin permisos asignados</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%!-- Desktop: Cards grid con permisos --%>
  <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <%= for role <- @roles do %>
      <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-6 flex flex-col">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-primary-900 dark:text-primary-100"><%= role.name %></h3>
            <p class="text-sm text-primary-500 dark:text-primary-400 mt-1"><%= role.description || "Sin descripción" %></p>
          </div>
          
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-800 text-primary-600 dark:text-primary-400">
            <%= length(role.permissions) %> permisos
          </span>
        </div>
        
        <%!-- Permisos agrupados --%>
        <div class="flex-1 mb-4">
          <div class="flex flex-wrap gap-1.5">
            <%= for permission <- Enum.take(role.permissions, 8) do %>
              <span class="px-2 py-1 rounded-lg text-xs bg-accent/10 text-accent-dark dark:text-accent border border-accent/20">
                <%= permission.code %>
              </span>
            <% end %>
            <%= if length(role.permissions) > 8 do %>
              <span class="px-2 py-1 rounded-lg text-xs bg-primary-100 dark:bg-primary-800 text-primary-500">
                +<%= length(role.permissions) - 8 %> más
              </span>
            <% end %>
            <%= if Enum.empty?(role.permissions) do %>
              <span class="text-sm text-primary-400 italic">Sin permisos asignados</span>
            <% end %>
          </div>
        </div>
        
        <%!-- Acciones --%>
        <div class="flex gap-2 pt-4 border-t border-primary-100 dark:border-primary-800">
          <button
            phx-click="edit"
            phx-value-id={role.id}
            class="flex-1 px-4 py-2 rounded-xl border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Editar
          </button>
          <button
            type="button"
            phx-click="confirm_delete"
            phx-value-id={role.id}
            class="px-4 py-2 rounded-xl border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <%!-- Modal para nuevo rol --%>
  <%= if @show_modal and @is_new do %>
    <.modal id="new-role-modal" show={true} size="lg" on_cancel={JS.push("close_modal")}>
      <div class="p-6 max-h-[80vh] overflow-y-auto">
        <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100 mb-6">
          Crear Nuevo Rol
        </h2>

        <form phx-submit="save_role" class="space-y-6">
          <%!-- Nombre y Descripción lado a lado en lg --%>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <%!-- Nombre --%>
            <div>
              <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
                Nombre del Rol
              </label>
              <input
                type="text"
                name="role[name]"
                value={@editing_role.name || ""}
                placeholder="Ej: Administrador, Editor, Lector"
                class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
              />
            </div>

            <%!-- Descripción --%>
            <div>
              <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
                Descripción
              </label>
              <textarea
                name="role[description]"
                placeholder="Describe el propósito de este rol..."
                rows="1"
                class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent resize-none"
              ><%= @editing_role.description || "" %></textarea>
            </div>
          </div>

          <%!-- Permisos en grid --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-3">
              Asignar Permisos
            </label>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-h-64 overflow-y-auto bg-primary-50 dark:bg-primary-900/20 rounded-lg p-4">
              <%= for {category, permissions} <- @permissions do %>
                <div class="space-y-2">
                  <h4 class="text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase">
                    <%= category %>
                  </h4>
                  <div class="space-y-1.5">
                    <%= for permission <- permissions do %>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input
                          type="checkbox"
                          name="permissions[]"
                          value={permission.id}
                          checked={MapSet.member?(@selected_permissions, permission.id)}
                          phx-click="toggle_permission"
                          phx-value-id={permission.id}
                          class="rounded border-primary-300 text-accent focus:ring-accent w-4 h-4"
                        />
                        <span class="text-xs text-primary-700 dark:text-primary-300">
                          <%= permission.code %>
                        </span>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <%!-- Botones --%>
          <div class="mt-8 flex gap-3 justify-end pt-4 border-t border-primary-100 dark:border-primary-800">
            <button
              type="button"
              phx-click={JS.push("close_modal")}
              class="px-6 py-2 rounded-lg border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors font-medium"
            >
              Cancelar
            </button>
            <button
              type="submit"
              style="background-color: #4e2a8e; color: white;"
              class="px-6 py-2 rounded-lg text-white hover:opacity-90 transition-opacity font-semibold"
            >
              Crear Rol
            </button>
          </div>
        </form>
      </div>
    </.modal>
  <% end %>

  <%!-- Modal para editar rol --%>
  <%= if @show_modal and !@is_new do %>
    <.modal id="edit-role-modal" show={true} size="lg" on_cancel={JS.push("close_modal")}>
      <div class="p-6 max-h-[80vh] overflow-y-auto">
        <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100 mb-6">
          Editar Rol
        </h2>

        <form phx-submit="save_role" class="space-y-6">
          <%!-- Nombre --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
              Nombre del Rol
            </label>
            <input
              type="text"
              name="role[name]"
              value={@editing_role.name}
              placeholder="Ej: Administrador, Editor, Lector"
              class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
            />
          </div>

          <%!-- Descripción --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
              Descripción
            </label>
            <textarea
              name="role[description]"
              placeholder="Describe el propósito de este rol..."
              rows="3"
              class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
            ><%= @editing_role.description %></textarea>
          </div>

          <%!-- Permisos --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-3">
              Asignar Permisos
            </label>
            <div class="space-y-3 max-h-64 overflow-y-auto bg-primary-50 dark:bg-primary-900/20 rounded-lg p-4">
              <%= for {category, permissions} <- @permissions do %>
                <div>
                  <h4 class="text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase mb-2">
                    <%= category %>
                  </h4>
                  <div class="space-y-2 ml-2">
                    <%= for permission <- permissions do %>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input
                          type="checkbox"
                          name="permissions[]"
                          value={permission.id}
                          checked={MapSet.member?(@selected_permissions, permission.id)}
                          phx-click="toggle_permission"
                          phx-value-id={permission.id}
                          class="rounded border-primary-300 text-accent focus:ring-accent"
                        />
                        <span class="text-sm text-primary-700 dark:text-primary-300">
                          <%= permission.code %>
                        </span>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <%!-- Botones --%>
          <div class="mt-8 flex gap-3 justify-end pt-4 border-t border-primary-100 dark:border-primary-800">
            <button
              type="button"
              phx-click={JS.push("close_modal")}
              class="px-6 py-2 rounded-lg border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors font-medium"
            >
              Cancelar
            </button>
            <button
              type="submit"
              style="background-color: #4e2a8e; color: white;"
              class="px-6 py-2 rounded-lg text-white hover:opacity-90 transition-opacity font-semibold"
            >
              Guardar
            </button>
          </div>
        </form>
      </div>
    </.modal>
  <% end %>

  <%!-- Modal de confirmación de eliminación --%>
  <%= if @show_delete_modal do %>
    <.modal id="confirm-delete-role-modal" show={true} size="md" on_cancel={JS.push("cancel_delete")}>
      <div class="p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 dark:bg-red-900/30">
            <svg class="h-6 w-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2m0 4v2M9.172 7.172a4 4 0 015.656 0m-5.656 8.484a4 4 0 005.656 0M9 11h.01M13 7h-2m0 4h2m-2 4h2" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100">
            Eliminar Rol
          </h2>
        </div>
        
        <p class="text-primary-600 dark:text-primary-400 mb-6">
          ¿Estás seguro de que deseas eliminar este rol? Esta acción no se puede deshacer. Los usuarios asociados perderán este rol.
        </p>

        <div class="flex gap-3 justify-end pt-4 border-t border-primary-100 dark:border-primary-800">
          <button
            type="button"
            phx-click={JS.push("cancel_delete")}
            class="px-6 py-2 rounded-lg border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors font-medium"
          >
            Cancelar
          </button>
          <button
            type="button"
            phx-click="delete"
            style="background-color: #dc2626;"
            class="px-6 py-2 rounded-lg text-white hover:opacity-90 transition-opacity font-semibold"
          >
            Eliminar
          </button>
        </div>
      </div>
    </.modal>
  <% end %>

</div>
