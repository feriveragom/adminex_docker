<div class="space-y-6">
  <%!-- Header con búsqueda --%>
  <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4 md:p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-4">
        <.link navigate={~p"/admin"} class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </.link>
        <div>
          <h1 class="text-xl md:text-2xl font-bold text-primary-900 dark:text-primary-100">Usuarios</h1>
          <p class="text-sm text-primary-500 dark:text-primary-400"><%= length(@users) %> usuarios registrados</p>
        </div>
      </div>

      <%!-- Búsqueda --%>
      <form phx-change="search" phx-submit="search" class="w-full md:w-auto">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            name="search"
            value={@search}
            placeholder="Buscar por email o nombre..."
            class="w-full md:w-80 pl-10 pr-4 py-2 rounded-xl border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
            phx-debounce="300"
          />
        </div>
      </form>
    </div>
  </div>

  <%!-- Mobile: Cards --%>
  <div class="md:hidden space-y-4">
    <%= for user <- @users do %>
      <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <%= if user.picture do %>
              <img src={user.picture} class="w-12 h-12 rounded-full object-cover" alt={user.name} />
            <% else %>
              <div class="w-12 h-12 rounded-full bg-gradient-elixir flex items-center justify-center text-white font-bold">
                <%= String.first(user.name || user.email) |> String.upcase() %>
              </div>
            <% end %>
            <div>
              <p class="font-semibold text-primary-900 dark:text-primary-100"><%= user.name || "Sin nombre" %></p>
              <p class="text-sm text-primary-500 dark:text-primary-400"><%= user.email %></p>
            </div>
          </div>

          <%!-- Acciones mobile --%>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="edit"
              phx-value-id={user.id}
              class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
              title="Editar"
            >
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </button>
            <button
              type="button"
              phx-click="toggle_active"
              phx-value-id={user.id}
              class={"p-2 rounded-lg transition-colors " <> if(user.active, do: "hover:bg-red-100 dark:hover:bg-red-900/30", else: "hover:bg-green-100 dark:hover:bg-green-900/30")}
              title={if user.active, do: "Desactivar", else: "Activar"}
            >
              <%= if user.active do %>
                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
              <% else %>
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              <% end %>
            </button>
            <button
              type="button"
              phx-click="confirm_delete"
              phx-value-id={user.id}
              class="p-2 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
              title="Eliminar"
            >
              <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-3 flex items-center gap-2 flex-wrap">
          <span class={"px-2 py-1 rounded-full text-xs font-medium " <> if(user.active, do: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400", else: "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400")}>
            <%= if user.active, do: "Activo", else: "Inactivo" %>
          </span>
          <%= if user.role do %>
            <span class="px-2 py-1 rounded-full text-xs font-medium bg-accent/20 text-accent-dark dark:text-accent">
              <%= user.role.name %>
            </span>
          <% end %>
          <%= if user.provider do %>
            <span class="px-2 py-1 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-800 text-primary-600 dark:text-primary-400">
              <%= user.provider %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%!-- Desktop: Table --%>
  <div class="hidden md:block bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-primary-50 dark:bg-primary-800/50">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Usuario</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Rol</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Proveedor</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Registrado</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary-100 dark:divide-primary-800">
          <%= for user <- @users do %>
            <tr class="hover:bg-primary-50 dark:hover:bg-primary-800/30 transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <%= if user.picture do %>
                    <img src={user.picture} class="w-10 h-10 rounded-full object-cover" alt={user.name} />
                  <% else %>
                    <div class="w-10 h-10 rounded-full bg-gradient-elixir flex items-center justify-center text-white font-bold text-sm">
                      <%= String.first(user.name || user.email) |> String.upcase() %>
                    </div>
                  <% end %>
                  <div>
                    <p class="font-medium text-primary-900 dark:text-primary-100"><%= user.name || "Sin nombre" %></p>
                    <p class="text-sm text-primary-500 dark:text-primary-400"><%= user.email %></p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <%= if user.role do %>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-accent/20 text-accent-dark dark:text-accent">
                    <%= user.role.name %>
                  </span>
                <% else %>
                  <span class="text-primary-400">—</span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <%= if user.provider do %>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-800 text-primary-600 dark:text-primary-400">
                    <%= user.provider %>
                  </span>
                <% else %>
                  <span class="text-primary-400">Local</span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <span class={"px-3 py-1 rounded-full text-xs font-medium " <> if(user.active, do: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400", else: "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400")}>
                  <%= if user.active, do: "Activo", else: "Inactivo" %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-primary-500 dark:text-primary-400">
                <%= Calendar.strftime(user.inserted_at, "%d/%m/%Y") %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-2">
                  <button
                    type="button"
                    phx-click="edit"
                    phx-value-id={user.id}
                    class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
                    title="Editar"
                  >
                    <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    phx-click="toggle_active"
                    phx-value-id={user.id}
                    class={"p-2 rounded-lg transition-colors " <> if(user.active, do: "hover:bg-red-100 dark:hover:bg-red-900/30", else: "hover:bg-green-100 dark:hover:bg-green-900/30")}
                    title={if user.active, do: "Desactivar", else: "Activar"}
                  >
                    <%= if user.active do %>
                      <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                      </svg>
                    <% else %>
                      <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    <% end %>
                  </button>
                  <button
                    type="button"
                    phx-click="confirm_delete"
                    phx-value-id={user.id}
                    class="p-2 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
                    title="Eliminar"
                  >
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%!-- Modal de edición --%>
  <%= if @editing_user do %>
    <.modal id="edit-user-modal" show={@show_modal} size="md" on_cancel={JS.push("close_modal")}>
      <div class="p-6 max-h-96 overflow-y-auto">
        <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100 mb-6">
          Editar Usuario
        </h2>

        <form phx-submit="save_user" class="space-y-4">
          <%!-- Nombre --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
              Nombre
            </label>
            <input
              type="text"
              name="user[name]"
              value={@editing_user.name}
              placeholder="Nombre completo"
              class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
            />
          </div>

          <%!-- Email --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
              Email
            </label>
            <input
              type="email"
              name="user[email]"
              value={@editing_user.email}
              placeholder="correo@ejemplo.com"
              class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
            />
          </div>

          <%!-- Rol --%>
          <div>
            <label class="block text-sm font-medium text-primary-700 dark:text-primary-300 mb-2">
              Rol
            </label>
            <select
              name="user[role_id]"
              class="w-full px-4 py-2 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
            >
              <%= for role <- @roles do %>
                <option value={role.id} selected={@editing_user.role_id == role.id}>
                  <%= role.name %>
                </option>
              <% end %>
            </select>
          </div>

          <%!-- Botones --%>
          <div class="mt-8 flex gap-3 justify-end pt-4 border-t border-primary-100 dark:border-primary-800">
            <button
              type="button"
              phx-click={JS.push("close_modal")}
              class="px-6 py-2 rounded-lg border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors font-medium"
            >
              Cancelar
            </button>
            <button
              type="submit"
              style="background-color: #4e2a8e; color: white;"
              class="px-6 py-2 rounded-lg text-white hover:opacity-90 transition-opacity font-semibold"
            >
              Guardar
            </button>
          </div>
        </form>
      </div>
    </.modal>
  <% end %>

  <%!-- Modal de confirmación de eliminación --%>
  <%= if @show_delete_modal do %>
    <.modal id="confirm-delete-modal" show={true} size="md" on_cancel={JS.push("cancel_delete")}>
      <div class="p-6">
        <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100 mb-4">
          Eliminar Usuario
        </h2>

        <p class="text-primary-600 dark:text-primary-400 mb-6">
          ¿Estás seguro de que deseas eliminar este usuario? Esta acción no se puede deshacer.
        </p>

        <div class="flex gap-3 justify-end pt-4 border-t border-primary-100 dark:border-primary-800">
          <button
            type="button"
            phx-click={JS.push("cancel_delete")}
            class="px-6 py-2 rounded-lg border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors font-medium"
          >
            Cancelar
          </button>
          <button
            type="button"
            phx-click="delete"
            style="background-color: #dc2626;"
            class="px-6 py-2 rounded-lg text-white hover:opacity-90 transition-opacity font-semibold"
          >
            Eliminar
          </button>
        </div>
      </div>
    </.modal>
  <% end %>

</div>
