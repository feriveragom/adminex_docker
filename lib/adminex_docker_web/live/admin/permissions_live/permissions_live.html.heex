<div class="space-y-6">
  <%!-- Header con búsqueda y botón nuevo --%>
  <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-4 md:p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-4">
        <.link navigate={~p"/admin"} class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </.link>
        <div>
          <h1 class="text-xl md:text-2xl font-bold text-primary-900 dark:text-primary-100">Permisos</h1>
          <p class="text-sm text-primary-500 dark:text-primary-400">
            <%= @permissions |> Map.values() |> List.flatten() |> length() %> permisos en <%= map_size(@permissions) %> grupos
          </p>
        </div>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-3">
        <%!-- Búsqueda --%>
        <form phx-change="search" phx-submit="search" class="flex-1">
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              name="search"
              value={@search}
              placeholder="Buscar permiso..."
              class="w-full pl-10 pr-4 py-2 rounded-xl border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 text-primary-900 dark:text-primary-100 focus:ring-2 focus:ring-accent focus:border-transparent"
              phx-debounce="300"
            />
          </div>
        </form>
        
        <%!-- Botón nuevo --%>
        <button
          phx-click="new"
          class="px-4 py-2 rounded-xl bg-gradient-elixir text-white font-medium hover:opacity-90 transition-opacity flex items-center gap-2 justify-center"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Nuevo Permiso</span>
        </button>
      </div>
    </div>
  </div>

  <%!-- Permisos agrupados --%>
  <div class="grid gap-6">
    <%= for {group, perms} <- @permissions do %>
      <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir overflow-hidden">
        <%!-- Header del grupo --%>
        <div class="bg-primary-50 dark:bg-primary-800/50 px-4 md:px-6 py-3 border-b border-primary-100 dark:border-primary-800">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-primary-700 dark:text-primary-300 uppercase tracking-wider">
              <%= group %>
            </h3>
            <span class="px-2 py-0.5 rounded-full text-xs bg-accent/20 text-accent-dark dark:text-accent">
              <%= length(perms) %> permisos
            </span>
          </div>
        </div>
        
        <%!-- Mobile: Cards --%>
        <div class="md:hidden divide-y divide-primary-100 dark:divide-primary-800">
          <%= for perm <- perms do %>
            <div class="p-4 flex items-start justify-between gap-4">
              <div class="flex-1">
                <p class="font-mono text-sm font-medium text-primary-900 dark:text-primary-100"><%= perm.code %></p>
                <p class="text-sm text-primary-500 dark:text-primary-400 mt-1"><%= perm.description || "Sin descripción" %></p>
              </div>
              <div class="flex items-center gap-1">
                <button
                  phx-click="edit"
                  phx-value-id={perm.id}
                  class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
                >
                  <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                </button>
                <button
                  phx-click="delete"
                  phx-value-id={perm.id}
                  data-confirm="¿Eliminar este permiso? Se removerá de todos los roles."
                  class="p-2 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
                >
                  <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          <% end %>
        </div>
        
        <%!-- Desktop: Table --%>
        <div class="hidden md:block">
          <table class="w-full">
            <tbody class="divide-y divide-primary-100 dark:divide-primary-800">
              <%= for perm <- perms do %>
                <tr class="hover:bg-primary-50 dark:hover:bg-primary-800/30 transition-colors">
                  <td class="px-6 py-4">
                    <code class="px-2 py-1 rounded bg-primary-100 dark:bg-primary-800 text-sm font-mono text-accent-dark dark:text-accent">
                      <%= perm.code %>
                    </code>
                  </td>
                  <td class="px-6 py-4 text-sm text-primary-600 dark:text-primary-400">
                    <%= perm.description || "Sin descripción" %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-2">
                      <button
                        phx-click="edit"
                        phx-value-id={perm.id}
                        class="p-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
                        title="Editar"
                      >
                        <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      </button>
                      <button
                        phx-click="delete"
                        phx-value-id={perm.id}
                        data-confirm="¿Eliminar este permiso? Se removerá de todos los roles."
                        class="p-2 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
                        title="Eliminar"
                      >
                        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>

</div>
