<div class="space-y-6">
  <%!-- Header del perfil --%>
  <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-6">
    <div class="flex flex-col sm:flex-row items-center gap-6">
      <%!-- Avatar con badge de verificado --%>
      <div class="relative">
        <%= if @current_user.picture do %>
          <img
            src={@current_user.picture}
            class="w-28 h-28 rounded-full ring-4 ring-primary-100 dark:ring-primary-800 shadow-lg"
            alt="Avatar"
          />
        <% else %>
          <div class="w-28 h-28 rounded-full bg-gradient-elixir flex items-center justify-center ring-4 ring-primary-100 dark:ring-primary-800 shadow-lg">
            <span class="text-white text-4xl font-bold">
              <%= String.first(@current_user.name || @current_user.email || "U") %>
            </span>
          </div>
        <% end %>
        <%!-- Badge verificado --%>
        <div class="absolute bottom-0 right-0 w-8 h-8 bg-green-500 rounded-full flex items-center justify-center ring-4 ring-card-light dark:ring-card-dark">
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>

      <%!-- Info del usuario --%>
      <div class="text-center sm:text-left">
        <h1 class="text-2xl sm:text-3xl font-bold text-primary-900 dark:text-primary-100">
          <%= @current_user.name || "Usuario" %>
        </h1>
        <div class="mt-2 flex flex-col sm:flex-row items-center gap-3 text-primary-600 dark:text-primary-400">
          <%!-- Email --%>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span><%= @current_user.email %></span>
          </div>
          <%!-- Rol --%>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span class="font-medium text-accent dark:text-accent-light"><%= @role %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Grid de cards --%>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%!-- Card: Detalles del Rol --%>
    <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-6 card-hover">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-primary-900 dark:text-primary-100">Detalles del Rol</h2>
      </div>

      <div class="space-y-4">
        <%!-- Rol Actual --%>
        <div>
          <p class="text-sm text-primary-500 dark:text-primary-400 font-medium">Rol Actual</p>
          <p class="text-xl font-bold text-primary-900 dark:text-primary-100"><%= @role %></p>
          <p class="text-sm text-primary-400 dark:text-primary-500">Rol asignado</p>
        </div>

        <%!-- ID de Usuario --%>
        <div>
          <p class="text-sm text-primary-400 dark:text-primary-500">ID de Usuario</p>
          <div class="mt-1 inline-flex items-center px-3 py-1.5 rounded-lg bg-primary-50 dark:bg-primary-900/30">
            <code class="text-sm font-mono text-primary-700 dark:text-primary-300"><%= @current_user[:id] || "N/A" %></code>
          </div>
        </div>
      </div>
    </div>

    <%!-- Card: Permisos Habilitados --%>
    <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-elixir p-6 card-hover">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-accent/20 dark:bg-accent/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-accent-dark dark:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-primary-900 dark:text-primary-100">Permisos Habilitados</h2>
      </div>

      <div class="space-y-3 max-h-64 overflow-y-auto custom-scrollbar pr-2">
        <%= for permission <- @permissions do %>
          <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors">
            <div class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="font-medium text-primary-900 dark:text-primary-100"><%= permission.code %></p>
              <p class="text-sm text-primary-400 dark:text-primary-500"><%= permission.description %></p>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Indicador de scroll --%>
      <%= if length(@permissions) > 3 do %>
        <div class="flex justify-center mt-3">
          <svg class="w-5 h-5 text-accent animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      <% end %>
    </div>
  </div>
</div>
