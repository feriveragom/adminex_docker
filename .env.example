# =============================================================================
# CONFIGURACIÓN DE ADMINEX
# =============================================================================
# Copia este archivo a .env y reemplaza los valores con los de tu proyecto
# cp .env.example .env

# =============================================================================
# DATABASE (Supabase PostgreSQL) - OBLIGATORIO
# =============================================================================
# Obtener de: Supabase Dashboard → Project Settings → Database → Connection String

# Pooled connection (para app runtime) - Puerto 6543
# DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct connection (para migraciones) - Puerto 5432
# DIRECT_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DIRECT_URL=

# =============================================================================
# PHOENIX - OBLIGATORIO
# =============================================================================
# Generar con: mix phx.gen.secret
SECRET_KEY_BASE=

# Host de la aplicación
# - Desarrollo: localhost
# - Producción: tu-app.gigalixirapp.com
PHX_HOST=localhost

# =============================================================================
# SUPABASE API - OPCIONAL
# =============================================================================
# Solo necesario si usas Supabase Auth, Storage, o Realtime
# Obtener de: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# =============================================================================
# GOOGLE OAUTH - OBLIGATORIO para login con Google
# =============================================================================
# Credenciales compartidas del proyecto adminex-oauth en Google Cloud
# Console: https://console.cloud.google.com/apis/credentials?project=adminex-oauth
#
# Para proyectos clonados: agregar tu dominio en Authorized redirect URIs

# Client ID (compartido - mismo para todos los proyectos clonados)
GOOGLE_CLIENT_ID=949847859878-p92a065ejloe6uqct4djlbaqoim7btg6.apps.googleusercontent.com

# Client Secret (obtener del owner del proyecto adminex-oauth)
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_CLIENT_SECRET=
